{
  "name": "cognitive-terrain",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "lint": "oxlint",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit tests/integration",
    "test:e2e": "playwright test",
    "test:visual": "playwright test -c playwright.visual.config.ts",
    "test:a11y": "playwright test -c playwright.a11y.config.ts",
    "test:perf": "node scripts/perf-check.mjs",
    "size:check": "node scripts/size-budget.mjs",
    "test:perf:update": "UPDATE_BASELINES=1 playwright test -c playwright.visual.config.ts",
    "migrate:local-notes": "node scripts/migrate-local-notes.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@react-three/postprocessing": "^3.0.4",
    "d3-contour": "^4.0.2",
    "idb": "^8.0.3",
    "lucide-react": "^1.28.0",
    "papaparse": "^5.5.4",
    "postprocessing": "^6.39.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "0.182.0",
    "umap-js": "1.4.0",
    "yaml": "^2.9.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.62.1",
    "@types/d3-contour": "^3.0.6",
    "@types/node": "^24.13.3",
    "@types/papaparse": "^5.3.16",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "0.182.0",
    "@vitejs/plugin-react": "^6.0.4",
    "fake-indexeddb": "^6.2.4",
    "fast-check": "^4.9.0",
    "oxlint": "^1.75.0",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
